FROM python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258

ARG SEMGREP_VERSION=1.180.0
ARG SCHEMATHESIS_VERSION=4.30.1
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/* \
    && python -m venv /opt/semgrep \
    && /opt/semgrep/bin/pip install --no-cache-dir "semgrep==${SEMGREP_VERSION}" \
    && python -m venv /opt/schemathesis \
    && /opt/schemathesis/bin/pip install --no-cache-dir "schemathesis==${SCHEMATHESIS_VERSION}" \
    && pip install --no-cache-dir PyYAML==6.0.3

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    SEMGREP_BIN=/opt/semgrep/bin/semgrep SCHEMATHESIS_BIN=/opt/schemathesis/bin/st \
    OFFENSIVE_PORT=8090 OFFENSIVE_DATA_DIR=/data/offensive/runs \
    OFFENSIVE_BENCHMARK_PATH=/opt/benchmark OFFENSIVE_SCHEMA_PATH=/opt/crapi-schema \
    OFFENSIVE_RULES_PATH=/app/rules/java-security.yml
WORKDIR /app
COPY lab/offensive/runner.py /app/runner.py
COPY lab/offensive/api_discovery.py /app/api_discovery.py
COPY lab/offensive/rules /app/rules
EXPOSE 8090
CMD ["python", "/app/runner.py"]

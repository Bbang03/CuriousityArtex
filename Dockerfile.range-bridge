FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssh-client ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY lab/attack-range/requirements-bridge.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY lab/attack-range/bridge.py lab/attack-range/runtime.py lab/attack-range/chain_runtime.py /app/
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
EXPOSE 8091
CMD ["python", "/app/bridge.py"]
